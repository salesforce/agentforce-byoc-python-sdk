[tool.poetry]
name = "{{project_name}}"
version = "0.1.0"
description = "Agentforce BYOC Agent"
authors = ["Your Name <you@example.com>"]
readme = "README.md"
packages = [{include = "main.py"}]

[tool.poetry.dependencies]
python = "^3.11"
# TODO(WI): the SDK is vendored into this project (the agentforce_byoc/
#   directory copied in by `agentforce init`) because it is not yet on PyPI.
#   Once it is published, REMOVE the vendored agentforce_byoc/ directory and
#   declare the dependency here instead:
# agentforce-byoc = "^0.1.0"

[tool.poetry.group.dev.dependencies]
pytest = "^7.4.0"
pytest-mock = "^3.11.1"
black = "^24.0.0"

[build-system]
requires = ["poetry-core"]
build-backend = "poetry.core.masonry.api"
