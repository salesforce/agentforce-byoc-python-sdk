# Agentforce BYOC Function - {{project_name}}
# Python 3.11 runtime

FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Copy dependency files
COPY pyproject.toml poetry.lock* ./

# Install Poetry
RUN pip install --no-cache-dir poetry==1.7.1

# Configure Poetry to not create virtual environment
RUN poetry config virtualenvs.create false

# Install dependencies
RUN poetry install --no-dev --no-interaction --no-ansi

# Copy application code
COPY main.py ./
COPY entry_func.py ./
COPY schema.py ./
COPY config.json ./

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV FUNCTION_ENTRY_POINT=main:function

# Health check (optional)
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD python -c "import main; print('OK')" || exit 1

# Run the function (this will be overridden by the BYOC runtime)
CMD ["python", "-c", "from main import function; import json; result = function({}); print(json.dumps(result))"]
