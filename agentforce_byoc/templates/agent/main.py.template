import json
from typing import TypedDict

# The agentforce_byoc SDK is vendored into this project directory (it is not
# yet on PyPI). Importing it gives access to the relay client + helpers.
from agentforce_byoc import get_client, get_logger
from agentforce_byoc.schema_utils import entry_func, requestSchema, responseSchema

logger = get_logger(__name__)

# Default prompt for the local-run sample request only (see `main`). A real
# invoke must supply `text`; `function` returns an input error if it is missing.
_DEFAULT_PROMPT = "Hello, Agentforce, What is the best place to eat dumplings in Seattle!"


# TODO: Define your function schemas here.
class ExampleRequest(TypedDict):
    """Request schema - define your input fields here."""

    text: str


class ExampleResponse(TypedDict):
    """Response schema - define your output fields here."""

    result: str
    status: str


@entry_func
@requestSchema(ExampleRequest)
@responseSchema(ExampleResponse)
def function(request: dict) -> dict:
    """
    Entry point called by the Agentforce BYOC runtime.

    Relays a chat-generations call through the Agentforce Relay API.

    Args:
        request: Input request dictionary from Agentforce. Expected fields:
                 - text: the user message

    Returns:
        Response dictionary {"result": ..., "status": ...}

    TODO: Implement your agent logic here.
    """
    logger.info("Processing request", extra={"request_keys": list(request.keys())})

    # Validate the caller-supplied `text`. Missing, null, or empty `text` is an
    # invalid invoke: return an input error instead of calling the relay, so an
    # empty invocation never incurs model traffic. (`_DEFAULT_PROMPT` is only for
    # local runs — `main()` uses it when there is no runtime-bound input.)
    text = request.get("text")
    if not text:
        logger.warning("Missing or empty 'text' field in request")
        return {"result": "", "status": "error"}

    try:
        client = get_client()

        # Relay a chat-generations call. `parameter` is the raw request body
        # for the LLM chat service and is passed through to the Relay API. The
        # tenant id, user id, and app context are resolved from the
        # runtime-injected environment (SFDC_CORE_TENANT_ID / SFDC_USER_ID /
        # SFDC_APP_CONTEXT).
        relay_response = client.call_llm_chat_generations(
            parameter={
                "messages": [{"role": "user", "content": text}],
                "generation_settings": {"max_tokens": 50},
                "model": "llmgateway__EinsteinLlama4Maverick",
            },
        )

        logger.info("Relay response received")
        return {"result": str(relay_response), "status": "success"}

    except Exception as e:
        logger.error(f"Request processing failed: {e}", exc_info=True)
        return {"result": "", "status": "error"}


