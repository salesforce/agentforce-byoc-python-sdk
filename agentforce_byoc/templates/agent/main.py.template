# Entry Point for Managed Sandbox / Module Execution
# ============================================================================
def main():
    """
    Entry point for Agentforce runtime execution.

    - Agentforce runtime: import main; main.main()
    - Script execution: python main.py (calls main via __name__ == "__main__")

    The invoke's ``input`` payload is bound by the runtime as the module global
    ``byoc_input`` before this file runs. We read it and pass it straight to
    ``function``. When running locally (``python main.py``), that global is not
    bound, so we fall back to a sample request. Only an *unbound* global selects
    the sample — a request the runtime explicitly binds is respected as-is, even
    an empty ``{}`` or ``None``, so an in-runtime invoke never silently runs the
    local sample.
    """
    print("Testing {{project_name}} agent...")
    print()

    # `byoc_input` is injected by the Agentforce runtime from the invoke's
    # `input` field. A unique sentinel as the `globals().get(...)` default lets
    # us distinguish "the runtime never bound the global" (local run → use the
    # sample) from "the runtime bound it to None/{}" (respect it). A plain
    # `is None` check would conflate the two and run the sample on a real null
    # invoke.
    # TODO: replace the placeholder request text used for local runs.
    _UNBOUND = object()
    request = globals().get("byoc_input", _UNBOUND)
    if request is _UNBOUND:
        request = {"text": _DEFAULT_PROMPT}

    print(f"Request: {request}")
    response = function(request)
    print(f"Response: {response}")

    # Emit the response as a `result: <json>` line. The Agentforce runtime scans
    # stdout for this line and returns the parsed value as the invoke response's
    # `result` field; without it, `result` comes back null.
    print(f"result: {json.dumps(response)}")
    print()

    return response


# ============================================================================
# Local Testing
# ============================================================================
if __name__ == "__main__":
    main()
